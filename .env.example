# ---- Supabase (required) -------------------------------------------------
# Project settings -> API. The service-role key is server-only: RLS is enabled
# with no policies, so nothing reads the database without it. Never expose it.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- TMDB (required) -----------------------------------------------------
# https://www.themoviedb.org/settings/api  (v3 key, not the v4 read token)
TMDB_API_KEY=
TMDB_CACHE_DAYS=30
TMDB_RPS=20

# ---- OMDb / IMDb (optional) ---------------------------------------------
# IMDb has no free public API and imdb.com must not be scraped. OMDb's free
# tier is 1000 calls/day, so this stays off unless you ask for it. With the
# flag off, TMDB's vote_average is the public rating and the UI says so.
ENABLE_IMDB=false
OMDB_API_KEY=
OMDB_CACHE_HOURS=24

# ---- Cron ----------------------------------------------------------------
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>`. Set it in Vercel
# and the nightly ingest route will refuse anything else.
CRON_SECRET=

# ---- Cinema (optional) ---------------------------------------------------
# CaptureDeck's Cinema tab calls /api/cinema/* with `Authorization: Bearer
# <CINEMA_TOKEN>` for scores and the history. Any long random string; paste the
# same one into Cinema -> twoscore. Unset, those routes refuse everything.
CINEMA_TOKEN=
